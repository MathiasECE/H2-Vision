{
  "version": 1,
  "author": "H2-Vision Team (ECE Paris)",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-ssd1306",
      "id": "oled",
      "top": -150,
      "left": 180,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_hall",
      "top": 120,
      "left": -140,
      "attrs": { "color": "green", "label": "Aimant Hall (Tour Arbre)" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_current",
      "top": -130,
      "left": -120,
      "attrs": { "label": "Courant Pile (0-15A)" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_throttle",
      "top": -10,
      "left": -130,
      "attrs": { "label": "Gachette Gaz (0-100%)" }
    },
    {
      "type": "wokwi-ntc-temperature-sensor",
      "id": "ntc",
      "top": 180,
      "left": 180,
      "attrs": { "temperature": "25" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    
    [ "esp:GND.1", "oled:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:22", "oled:SCL", "yellow", [ "v0" ] ],
    [ "esp:21", "oled:SDA", "blue", [ "v0" ] ],

    [ "esp:GND.1", "btn_hall:1.l", "black", [ "v0" ] ],
    [ "esp:4", "btn_hall:2.l", "green", [ "v0" ] ],

    [ "esp:GND.1", "pot_current:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "pot_current:VCC", "red", [ "v0" ] ],
    [ "esp:34", "pot_current:SIG", "orange", [ "v0" ] ],

    [ "esp:GND.1", "pot_throttle:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "pot_throttle:VCC", "red", [ "v0" ] ],
    [ "esp:35", "pot_throttle:SIG", "purple", [ "v0" ] ],

    [ "esp:GND.2", "ntc:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "ntc:VCC", "red", [ "v0" ] ],
    [ "esp:32", "ntc:OUT", "cyan", [ "v0" ] ]
  ],
  "dependencies": {}
}
